# Offline development defaults. Real secrets belong only in your local .env.
RETRIEVER_BACKEND=fake
# FIXTURES_PATH defaults to this module's fixtures/documents.jsonl, independent of cwd.

OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=streamrag-docs-v1
OPENSEARCH_VECTOR_FIELD=embedding
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
RETRIEVAL_TIMEOUT_SECONDS=10
EMBEDDING_DIM=384
# OpenSearch mode requires a zero-argument factory from TV4's shared module.
# Example after TV4 hands off embedding.py: EMBEDDER_FACTORY=embedding:Embedder
EMBEDDER_FACTORY=

LLM_PROVIDER=mock
# Ollama: http://localhost:11434; OpenAI-compatible: provider base URL including /v1.
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
