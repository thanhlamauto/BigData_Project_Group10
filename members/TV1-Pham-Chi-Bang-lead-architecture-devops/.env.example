# StreamRAG — configuration template.
# Copy to .env (`cp .env.example .env`) and adjust. NEVER commit .env.
# Values below are LOCAL DEVELOPMENT defaults only; none of them is a real secret.

# --- Kafka -------------------------------------------------------------------
# From the host use localhost:9092; containers inside Compose use kafka:29092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_HOST_PORT=9092
RAW_TOPIC=streamrag.raw.v1
CLEANED_TOPIC=streamrag.cleaned.v1

# --- MinIO / S3-compatible data lake -----------------------------------------
# From the host use http://localhost:9000; containers use http://minio:9000.
MINIO_ENDPOINT=http://localhost:9000
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
LAKE_BUCKET=streamrag-lake

# --- OpenSearch --------------------------------------------------------------
# From the host use http://localhost:9200; containers use http://opensearch:9200.
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INTERNAL_URL=http://opensearch:9200
OPENSEARCH_HOST_PORT=9200
OPENSEARCH_INDEX=streamrag-docs-v1

# --- Embedding (owner: TV4) --------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- LLM (owner: TV5) --------------------------------------------------------
# LLM_PROVIDER: ollama | openai | mock   (mock = offline tests only)
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=
# Put a real key only in your local .env, never here.
LLM_API_KEY=

# --- API (owner: TV5) --------------------------------------------------------
API_HOST_PORT=8000
